from abc import ABC, abstractmethod

class Pago(ABC):
    @abstractmethod
    def procesar_pago(self):
        pass
    
class TarjetaCredito(Pago):
    def procesar_pago(self):
        return "El pago fue procesado en TarjetaCredito."

class PayPal(Pago):
    def procesar_pago(self):
        return "El pago fue procesado en PayPal."

# objeto de prueba

pago1 = TarjetaCredito()
pago2 = PayPal()

print(pago1.procesar_pago())
print(pago2.procesar_pago())
